generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  nama      String
  noWa      String    @map("no_wa")
  persona   String?
  alamat    String?
  createdAt DateTime  @default(now()) @map("created_at")
  bookings  Booking[]

  @@map("users")
}

model Booking {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  kodeBooking     String           @unique @map("kode_booking")
  userId          String           @map("user_id") @db.ObjectId
  kategori        String           // A, B, CUSTOM
  durasiBulan     Int              @map("durasi_bulan")
  totalHarga      Int              @map("total_harga")
  status          String           @default("LEAD")
  tanggalPickup   DateTime?        @map("tanggal_pickup")
  lokasiPickup    String?          @map("lokasi_pickup")
  adminId         String?          @map("admin_id") @db.ObjectId
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  user            User             @relation(fields: [userId], references: [id])
  admin           AdminUser?       @relation(fields: [adminId], references: [id])
  items           BookingItem[]
  quotation       Quotation?
  conditionReport ConditionReport?
  weeklyUpdates   WeeklyUpdate[]
  agreement       Agreement?
  statusLogs      StatusLog[]

  @@map("bookings")
}

model BookingItem {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  bookingId  String   @map("booking_id") @db.ObjectId
  namaBarang String   @map("nama_barang")
  tipe       String   // KECIL, ELEKTRONIK_KECIL, BESAR, ELEKTRONIK_BESAR, KENDARAAN
  jumlah     Int      @default(1)
  catatan    String?

  booking    Booking  @relation(fields: [bookingId], references: [id])

  @@map("booking_items")
}

model Quotation {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  bookingId     String    @unique @map("booking_id") @db.ObjectId
  kategori      String
  hargaPerBulan Int       @map("harga_per_bulan")
  totalHarga    Int       @map("total_harga")
  status        String    @default("PENDING") // PENDING, APPROVED, REJECTED
  isCustom      Boolean   @default(false) @map("is_custom")
  catatanCustom String?   @map("catatan_custom")
  approvedAt    DateTime? @map("approved_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  booking       Booking   @relation(fields: [bookingId], references: [id])

  @@map("quotations")
}

model ConditionReport {
  id            String                 @id @default(auto()) @map("_id") @db.ObjectId
  bookingId     String                 @unique @map("booking_id") @db.ObjectId
  status        String                 @default("MENUNGGU_VERIFIKASI")
  picKurir      String?                @map("pic_kurir")
  tanggalPickup DateTime?              @map("tanggal_pickup")
  fotoBefore    String?                @map("foto_before")
  fotoAfter     String?                @map("foto_after")
  fotoWrapping  String?                @map("foto_wrapping")
  userApproved  Boolean                @default(false) @map("user_approved")
  approvedAt    DateTime?              @map("approved_at")
  createdAt     DateTime               @default(now()) @map("created_at")

  booking       Booking                @relation(fields: [bookingId], references: [id])
  items         ConditionReportItem[]

  @@map("condition_reports")
}

model ConditionReportItem {
  id                String          @id @default(auto()) @map("_id") @db.ObjectId
  conditionReportId String          @map("condition_report_id") @db.ObjectId
  namaBarang        String          @map("nama_barang")
  kondisiAwal       String          @map("kondisi_awal") // BAIK, ADA_CACAT
  catatanCacat      String?         @map("catatan_cacat")
  fotoBefore        String?         @map("foto_before")

  conditionReport   ConditionReport @relation(fields: [conditionReportId], references: [id])

  @@map("condition_report_items")
}

model WeeklyUpdate {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  bookingId     String     @map("booking_id") @db.ObjectId
  mingguKe      Int        @map("minggu_ke")
  tanggalUpdate DateTime   @map("tanggal_update")
  foto          String?
  keterangan    String?
  dikirimVia    String     @default("WHATSAPP") @map("dikirim_via")
  adminId       String?    @map("admin_id") @db.ObjectId
  createdAt     DateTime   @default(now()) @map("created_at")

  booking       Booking    @relation(fields: [bookingId], references: [id])
  admin         AdminUser? @relation(fields: [adminId], references: [id])

  @@map("weekly_updates")
}

model Agreement {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  bookingId  String    @unique @map("booking_id") @db.ObjectId
  status     String    @default("DRAFT") // DRAFT, SIGNED, CANCELLED
  bermaterai Boolean   @default(false)
  tanggalTtd DateTime? @map("tanggal_ttd")
  fileUrl    String?   @map("file_url")
  createdAt  DateTime  @default(now()) @map("created_at")

  booking    Booking   @relation(fields: [bookingId], references: [id])

  @@map("agreements")
}

model StatusLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  bookingId  String   @map("booking_id") @db.ObjectId
  statusLama String?  @map("status_lama")
  statusBaru String   @map("status_baru")
  diubahOleh String   @map("diubah_oleh")
  catatan    String?
  createdAt  DateTime @default(now()) @map("created_at")

  booking    Booking  @relation(fields: [bookingId], references: [id])

  @@map("status_logs")
}

model AdminUser {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  nama          String
  role          String         // ADMIN, KURIR, OBSERVER, ESCALATION
  noWa          String         @map("no_wa")
  createdAt     DateTime       @default(now()) @map("created_at")
  bookings      Booking[]
  weeklyUpdates WeeklyUpdate[]

  @@map("admin_users")
}
